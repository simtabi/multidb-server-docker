{
  "_comment": "Rendered by scripts/env-render into pgAdmin's servers.json so the UI opens with the toolkit's PostgreSQL already listed (SPEC section 7). Contains no password: pgAdmin prompts for it, and the toolkit never writes a credential into a rendered file.",
  "Servers": {
    "1": {
      "Name": "my-multidb-server PostgreSQL ${MMDB_PG_VERSION:-17}",
      "Group": "my-multidb-server",
      "Host": "pg",
      "Port": 5432,
      "MaintenanceDB": "${MMDB_PG_DEFAULT_DB:-postgres}",
      "Username": "postgres",
      "SSLMode": "prefer",
      "Comment": "Provisioned by my-multidb-server. Connect over the internal mmdb network."
    }
  }
}
