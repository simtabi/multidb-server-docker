#!/usr/bin/env bash
#
# Rotate server certificates without downtime (SPEC section 9.1).
#
# The CA is deliberately NOT rotated. Every client that trusts ca.crt would
# have to be updated in lockstep, which is a coordinated outage rather than a
# renewal. Server certificates are signed by the same CA, so clients keep
# working across the rotation with no change at all.
#
# Each engine reloads differently, and the differences are not cosmetic:
#   PostgreSQL  pg_reload_conf()          re-reads the cert files
#   MySQL       ALTER INSTANCE RELOAD TLS
#   MariaDB     FLUSH SSL
#
# Usage: scripts/certs-renew

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 1

log() { printf '[certs-renew] %s\n' "$*"; }
die() { printf '[certs-renew] ERROR: %s\n' "$*" >&2; exit 1; }

[[ -s certs/ca.crt ]] || die "no toolkit CA yet; run 'make certs' first"

before="$(openssl x509 -in certs/pg/server.crt -noout -enddate 2>/dev/null | cut -d= -f2 || echo unknown)"
log "current pg certificate expires: $before"

# Re-issue the server certificates, keeping the existing CA.
scripts/certs --renew || die "certificate re-issue failed"

after="$(openssl x509 -in certs/pg/server.crt -noout -enddate 2>/dev/null | cut -d= -f2 || echo unknown)"
log "new pg certificate expires: $after"

# The certificates are mounted read-only into the engines, so the new files are
# already visible inside the containers. All that remains is to make each
# engine re-read them.
running() { docker compose ps --format '{{.Service}}' 2>/dev/null | grep -qx "$1"; }

reloaded=0

if running pg; then
    # The image copies mounted certs into place during its dbtk-certs stage, so
    # a reload alone would still serve the old pair. Re-running that stage
    # first is what makes this a genuine rotation rather than a no-op.
    docker compose exec -T pg /usr/local/lib/dbtk/30-certs.sh >/dev/null 2>&1 || true
    docker compose exec -T pg psql -U postgres -tAc "SELECT pg_reload_conf()" >/dev/null 2>&1 \
        || die "PostgreSQL did not reload its configuration"
    log "pg reloaded via pg_reload_conf()"
    reloaded=$(( reloaded + 1 ))
fi

if running mysql; then
    pw="$(cat secrets/mysql_root_password.txt)"
    docker compose exec -T mysql /usr/local/lib/dbtk/30-certs.sh >/dev/null 2>&1 || true
    docker compose exec -T mysql mysql -uroot -p"$pw" --protocol=socket \
        -e "ALTER INSTANCE RELOAD TLS;" >/dev/null 2>&1 \
        || die "MySQL did not reload TLS"
    log "mysql reloaded via ALTER INSTANCE RELOAD TLS"
    reloaded=$(( reloaded + 1 ))
fi

if running mariadb; then
    pw="$(cat secrets/mariadb_root_password.txt)"
    docker compose exec -T mariadb /usr/local/lib/dbtk/30-certs.sh >/dev/null 2>&1 || true
    docker compose exec -T mariadb mariadb -uroot -p"$pw" --protocol=socket \
        -e "FLUSH SSL;" >/dev/null 2>&1 \
        || die "MariaDB did not reload TLS"
    log "mariadb reloaded via FLUSH SSL"
    reloaded=$(( reloaded + 1 ))
fi

if (( reloaded == 0 )); then
    log "no engines are running; the new certificates will be used at next start"
else
    log "rotated and reloaded $reloaded engine(s) with no restart"
fi

printf '\n'
printf 'The CA was NOT rotated, so clients trusting certs/ca.crt need no change.\n'
