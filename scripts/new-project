#!/usr/bin/env bash
#
# Provision a project: database, least-privilege owner role, readonly role, the
# configured extensions, and a paste-ready connection block (SPEC sections 8
# and 14).
#
# This is the command SPEC section 1's promise rests on -- "a new project
# connects in under a minute" -- so it does the whole job and prints exactly
# what the caller needs next, rather than provisioning and leaving them to work
# out the connection details.
#
# It used to branch on the engine and supported three of the six. Everything
# engine-specific now lives in the family hooks, so a new engine gets
# new-project by existing rather than by someone remembering to add a case.
#
# Usage: scripts/new-project --name myapp [--engine pg|mysql|mariadb|mongodb|cassandra|ferretdb]

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 1

# shellcheck source=engine-lib.sh
. "$ROOT/scripts/engine-lib.sh"

ENV_FILE="${MMDB_ENV_FILE:-$ROOT/.env}"
[[ -f "$ENV_FILE" ]] || ENV_FILE="$ROOT/.env.example"

get() { grep -E "^${1}=" "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true; }
log() { printf '[new-project] %s\n' "$*"; }
die() { printf '[new-project] ERROR: %s\n' "$*" >&2; exit 1; }

NAME=""
ENGINE="pg"
while (( $# )); do
    case "$1" in
        --name)   NAME="${2:-}"; shift 2 ;;
        --engine) ENGINE="${2:-}"; shift 2 ;;
        *) die "unknown argument: $1" ;;
    esac
done

[[ -n "$NAME" ]] || die "specify --name <project>"

# Identifiers go into SQL and CQL, so they are constrained rather than escaped.
# A name that needs quoting is a name that will cause trouble in a connection
# string later anyway.
[[ "$NAME" =~ ^[a-z][a-z0-9_]{0,62}$ ]] \
    || die "invalid name '$NAME': use lowercase letters, digits and underscores, starting with a letter"

# -----------------------------------------------------------------------------
# Engine
# -----------------------------------------------------------------------------
# Descriptors are keyed by directory name; engines are addressed by their
# MMDB_ENGINE_NAME. `pg` is the descriptor in engines/postgres/, so a lookup by
# directory alone would reject the toolkit's own default.
resolved=""
for candidate in $(engine_list); do
    engine_load "$candidate" || continue
    if [[ "$MMDB_ENGINE_NAME" == "$ENGINE" || "$candidate" == "$ENGINE" ]]; then
        resolved="$candidate"
        break
    fi
done
[[ -n "$resolved" ]] || die "unknown engine: $ENGINE (have: $(engine_list | tr '\n' ' '))"
engine_load "$resolved" || die "could not load the descriptor for $resolved"
ENGINE="$MMDB_ENGINE_NAME"

engine_load_hooks || die "no hooks for engine family ${MMDB_ENGINE_FAMILY:-?}"
command -v hook_provision_project >/dev/null 2>&1 \
    || die "the ${MMDB_ENGINE_FAMILY} family defines no hook_provision_project"

DB="$NAME"
USER_NAME="${NAME}_user"

# -----------------------------------------------------------------------------
# The hook contract's environment
# -----------------------------------------------------------------------------
# Same shape as scripts/backup: hooks call engine_exec and secret rather than
# knowing whether they are inside a container or on the host.
IN_CONTAINER="${MMDB_IN_CONTAINER:-0}"

engine_exec() {
    local engine="$1"; shift
    if [[ "$IN_CONTAINER" == "1" ]]; then
        "$@"
    else
        ( cd "$ROOT" && docker compose exec -T "$engine" "$@" )
    fi
}

secret() {
    local file="$1"
    if [[ "$IN_CONTAINER" == "1" ]]; then
        [[ -r "/run/secrets/$file" ]] || die "secret not readable: /run/secrets/$file"
        tr -d '\n' < "/run/secrets/$file"
    else
        [[ -r "$ROOT/secrets/$file" ]] || die "secret not readable: secrets/$file"
        tr -d '\n' < "$ROOT/secrets/$file"
    fi
}

# Only the dump path compresses; provisioning has no artefact. Defined because
# the family files are shared and may reference it at source time.
compress_ext() { printf ''; }

# -----------------------------------------------------------------------------
# Passwords
# -----------------------------------------------------------------------------
# The owner and the read-only role get DIFFERENT passwords. They are separate
# principals, and a shared credential means leaking the read-only one leaks the
# writable one too.
gen_password() {
    local file="$1"
    if [[ -s "$file" ]]; then
        log "reusing the existing password in $file"
    else
        mkdir -p secrets
        openssl rand -base64 96 | LC_ALL=C tr -dc 'A-Za-z0-9' | cut -c1-40 > "$file"
        chmod 0600 "$file"
        log "generated $file"
    fi
}

SECRET_FILE="secrets/${ENGINE}_${USER_NAME}_password.txt"
RO_SECRET_FILE="secrets/${ENGINE}_${USER_NAME}_readonly_password.txt"
gen_password "$SECRET_FILE"
gen_password "$RO_SECRET_FILE"
PASSWORD="$(cat "$SECRET_FILE")"
RO_PASSWORD="$(cat "$RO_SECRET_FILE")"

# -----------------------------------------------------------------------------
# Provision
# -----------------------------------------------------------------------------
upper="$(printf '%s' "$ENGINE" | tr '[:lower:]-' '[:upper:]_')"
EXTENSIONS="$(get "MMDB_${upper}_INIT_EXTENSIONS")"

hook_provision_project "$DB" "$USER_NAME" "$PASSWORD" "$EXTENSIONS" "$RO_PASSWORD" \
    || die "provisioning failed on $ENGINE; is it running? (make up PROFILES=$ENGINE)"

log "provisioned '$DB' on $ENGINE, owned by '$USER_NAME'"
[[ -n "$EXTENSIONS" ]] && log "extensions requested: $EXTENSIONS"

# -----------------------------------------------------------------------------
# The paste-ready block (SPEC section 14)
# -----------------------------------------------------------------------------
cat <<BLOCK

────────────────────────────────────────────────────────────────────────
Paste into your .env:

DB_CONNECTION=${MMDB_ENGINE_DRIVER}
DB_HOST=${ENGINE}
DB_PORT=${MMDB_ENGINE_PORT}
DB_DATABASE=${DB}
DB_USERNAME=${USER_NAME}
DB_PASSWORD=${PASSWORD}
BLOCK

if engine_tls_always; then
    cat <<'BLOCK'

# TLS is always on for this engine. verify-full is the only mode that checks
# the hostname, so it is the only one worth using; point it at the toolkit CA:
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/path/to/my-multidb-server/certs/ca.crt
BLOCK
else
    cat <<'BLOCK'

# In the prod profile the server refuses plaintext TCP, so point your client
# at the toolkit CA:
DB_SSL_CA=/path/to/my-multidb-server/certs/ca.crt
BLOCK
fi

if engine_has_external_pooler; then
    cat <<BLOCK

# A pooler is available and is REQUIRED in production for this engine. With
# \`make up PROFILES=${ENGINE},pooler\`, connect through it instead:
#   DB_PORT=${MMDB_ENGINE_POOLER_PORT:-6432}
BLOCK
fi

cat <<BLOCK

Your app container must join the toolkit network:

  networks:
    default:
      external: true
      name: ${COMPOSE_PROJECT_NAME:-mmdb}_net

Passwords also live in:
  ${SECRET_FILE}
  ${RO_SECRET_FILE}   (read-only role '${USER_NAME}_readonly')
────────────────────────────────────────────────────────────────────────
BLOCK
