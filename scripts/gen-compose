#!/usr/bin/env bash
# shellcheck disable=SC2016  # printf emits compose ${VAR} references verbatim
#
# Generate the engine services from the descriptors (SPEC section 22.1).
#
# The hand-written alternative was a compose service per engine, each ~40 lines
# of near-identical YAML differing in a handful of values the descriptor
# already states. That is exactly the shape that rots: six engines means six
# places to forget a hardening flag.
#
# Output is compose.engines.yml, which is generated and gitignored. Compose
# picks it up via COMPOSE_FILE in .env, so a bare `docker compose` anywhere --
# in a script, in a check, at your prompt -- sees the engines without needing
# -f flags.
#
# Non-engine services (UIs, Caddy, exporters, backup sidecars) stay in
# docker-compose.yml, hand-written, because there is one of each.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 1

# shellcheck source=engine-lib.sh
. "$ROOT/scripts/engine-lib.sh"

# Every MDB_<ENGINE>_* variable documented in .env.example is passed through.
# Enumerating them in this generator would put engine knowledge back into it,
# which is precisely what the descriptor exists to prevent.
emit_engine_env() {
    local up="$1" v
    # shellcheck disable=SC2013  # variable NAMES contain no whitespace
    for v in $(grep -oE "^#?MDB_${up}_[A-Z0-9_]+" .env.example 2>/dev/null \
                 | sed 's/^#//' | sort -u); do
        case "$v" in
            *_VERSION|*_HOST_PORT|*_DATABASES|*_EMBED_EXPORTER|*_EMBED_BACKUP) continue ;;
        esac
        printf '      %s: ${%s:-}\n' "$v" "$v"
    done
    for v in MDB_CPUS MDB_SOCKETS MDB_MTLS MDB_EXTRA_SANS; do
        printf '      %s: ${%s:-}\n' "$v" "$v"
    done
}


# -----------------------------------------------------------------------------
# Exposure
# -----------------------------------------------------------------------------
# Ten published host ports across a modest profile set is ten chances to collide
# with something already on the machine, and every collision surfaces as a
# Docker error at the end of a boot. So publishing is a DECISION, not a default:
#
#   none    (default) publish nothing. Applications join the mdb network and
#           reach engines by service name -- which is what `make new-project`
#           has always printed. Zero published ports, zero conflicts.
#   direct  every engine publishes its own port, as before.
#   proxy   one front door publishes a contiguous range; engines stay internal.
#
# In direct and proxy mode a port is BASE + offset, so a collision is fixed by
# changing one number instead of hunting through per-engine variables.
ENV_FILE="${MDB_ENV_FILE:-$ROOT/.env}"
[ -f "$ENV_FILE" ] || ENV_FILE="$ROOT/.env.example"
get() { grep -E "^${1}=" "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true; }

PUBLISH="$(get MDB_PUBLISH)"; PUBLISH="${PUBLISH:-none}"
PORT_BASE="$(get MDB_PORT_BASE)"; PORT_BASE="${PORT_BASE:-54000}"

# Emit a ports: block, or nothing at all.
#   $1 variable name for an explicit override, $2 offset from the base,
#   $3 the container port.
emit_ports() {
    local var="$1" offset="$2" container="$3"
    case "$PUBLISH" in
        direct) ;;
        *) return 0 ;;
    esac
    printf '    ports:\n'
    printf '      - "${MDB_BIND_ADDR:-127.0.0.1}:${%s:-%s}:%s"\n' \
        "$var" "$(( PORT_BASE + offset ))" "$container"
}

OUT="$ROOT/compose.engines.yml"
tmp="$(mktemp)"

{
    printf '# GENERATED by scripts/gen-compose from engines/*/engine.conf.\n'
    printf '# Do not edit: your changes will be overwritten on the next `make up`.\n'
    printf '# Edit the descriptor instead.\n\n'
    printf 'services:\n'
} > "$tmp"

count=0
poolers=0
for engine in $(engine_list); do
    engine_load "$engine" || continue

    upper="$(printf '%s' "$MDB_ENGINE_NAME" | tr '[:lower:]-' '[:upper:]_')"

    # A referenced engine is not rebuilt under our namespace, so it runs the
    # upstream image directly (SPEC section 22.5). Everything else runs the
    # image we publish.
    if [ "${MDB_ENGINE_PUBLISH:-derive}" = "reference" ]; then
        image_line="\${MDB_${upper}_IMAGE:-$(awk -v e="$MDB_ENGINE_NAME" -v v="$MDB_ENGINE_DEFAULT_VERSION" \
            '$1==e && $2==v {print $3; exit}' images/bases.tsv)}"
        build_block=""
    else
        image_line="ghcr.io/simtabi/multidb-server-${MDB_ENGINE_NAME}:\${MDB_${upper}_VERSION:-${MDB_ENGINE_DEFAULT_VERSION}}"
        build_block="    build:
      context: ./images
      dockerfile: ${MDB_ENGINE_NAME}/Dockerfile
      args:
        ENGINE_VERSION: \${MDB_${upper}_VERSION:-${MDB_ENGINE_DEFAULT_VERSION}}
"
    fi

    {
        printf '  # ---------------------------------------------------------------------------\n'
        printf '  # %s (%s, %s)\n' "$MDB_ENGINE_TITLE" "$MDB_ENGINE_PARADIGM" "$MDB_ENGINE_LICENSE"
        if [ "${MDB_ENGINE_PUBLISH:-derive}" = "reference" ]; then
            printf '  # Referenced, not published: %s\n' "${MDB_ENGINE_LICENSE_NOTE:-see SPEC 22.5}"
        fi
        printf '  # ---------------------------------------------------------------------------\n'
        printf '  %s:\n' "$MDB_ENGINE_NAME"
        printf '    profiles: [%s]\n' "$MDB_ENGINE_NAME"
        [ -n "$build_block" ] && printf '%s' "$build_block"
        printf '    image: %s\n' "$image_line"
        printf '    restart: unless-stopped\n'
        printf '    security_opt:\n      - no-new-privileges:true\n'
        printf '    cap_drop:\n      - ALL\n'
        # The engine needs these back for the s6 init stages and the upstream
        # entrypoint's drop to the engine user.
        printf '    cap_add: [CHOWN, SETUID, SETGID, DAC_OVERRIDE, FOWNER]\n'
        printf '    environment:\n'
        printf '      %s: /run/secrets/%s\n' "$MDB_ENGINE_ROOT_PW_ENV" "$MDB_ENGINE_ROOT_SECRET"
        printf '      MDB_TLS_ENFORCE: ${MDB_TLS_ENFORCE:-false}\n'
        printf '      MDB_MEM: ${MDB_MEM:-4}\n'
        printf '      MDB_TZ: ${MDB_TZ:-UTC}\n'
        printf '      MDB_%s_DATABASES: ${MDB_%s_DATABASES:-}\n' "$upper" "$upper"
        # Embedded helpers stay OFF under compose, which runs them as separate
        # services (SPEC section 6.1).
        printf '      MDB_%s_EMBED_EXPORTER: "false"\n' "$upper"
        printf '      MDB_%s_EMBED_BACKUP: "false"\n' "$upper"
        emit_engine_env "$upper"
        # An engine may need variables of the image's own, not MDB_ ones.
        # These go INSIDE the environment block; service-level settings use
        # compose-extra.yml instead.
        [ -f "$MDB_ENGINE_DIR/compose-env.yml" ] && cat "$MDB_ENGINE_DIR/compose-env.yml"
        printf '    volumes:\n'
        printf '      - %s_data:%s\n' "$MDB_ENGINE_NAME" "$MDB_ENGINE_DATA_DIR"
        printf '      - ./certs:/certs:ro\n'
        printf '      - ./secrets:/run/secrets:ro\n'
        printf '      - ./overrides/%s:%s:ro\n' "$MDB_ENGINE_NAME" "$MDB_ENGINE_OVERRIDES_DIR"
        # The PITR repository. A named volume, not a bind mount, and separate
        # from the data volume on purpose: a backup living inside the thing it
        # backs up is not a backup, and `make destroy` takes the data with it.
        if [ "${MDB_ENGINE_PITR_CAPABLE:-false}" = "true" ]; then
            printf '      - %s_pitr:%s\n' \
                "$MDB_ENGINE_NAME" "${MDB_ENGINE_PITR_REPO_PATH:-/var/lib/pgbackrest}"
        fi
        # The offset is the engine's own default port, so PORT_BASE+5432 is
        # recognisably PostgreSQL and the mapping stays memorable.
        emit_ports "MDB_${upper}_HOST_PORT" "$MDB_ENGINE_PORT_OFFSET" "$MDB_ENGINE_PORT"
        # Docker's 10s default force-kills a database mid-checkpoint.
        printf '    stop_grace_period: ${MDB_STOP_GRACE:-60s}\n'
        printf '    networks: [mdb]\n'
        printf '    logging:\n      driver: json-file\n'
        printf '      options:\n'
        printf '        max-size: ${MDB_LOG_MAX_SIZE:-10m}\n'
        printf '        max-file: "${MDB_LOG_MAX_FILE:-3}"\n'
        # Genuinely engine-specific service settings -- PostgreSQL's shm_size,
        # the MySQL family's ulimits, Cassandra's heap -- live beside the
        # descriptor rather than as branches in here.
        [ -f "$MDB_ENGINE_DIR/compose-extra.yml" ] && cat "$MDB_ENGINE_DIR/compose-extra.yml"
        printf '\n'
    } >> "$tmp"

    # -------------------------------------------------------------------------
    # Pooler, for engines that declare an external one (SPEC section 22.4).
    #
    # Gated on a compose-pooler.yml beside the descriptor rather than on
    # POOLING=external alone. Declaring the image is not the same as having
    # configured it, and generating a service from a half-answer would produce
    # a pooler that starts and does not work -- worse than none, because it
    # looks present.
    #
    # compose-pooler.yml holds environment ENTRIES ONLY, with no `environment:`
    # header of its own: the header is emitted here so the secret and the
    # upstream address cannot be overridden, and two `environment:` keys in one
    # service is a YAML duplicate that silently keeps only the last.
    # -------------------------------------------------------------------------
    if [ "${MDB_ENGINE_POOLING:-driver}" = "external" ] \
       && [ -n "${MDB_ENGINE_POOLER_IMAGE:-}" ] \
       && [ -f "$MDB_ENGINE_DIR/compose-pooler.yml" ]; then
        {
            printf '  # ---------------------------------------------------------------------------\n'
            printf '  # %s pooler\n' "$MDB_ENGINE_TITLE"
            printf '  # ---------------------------------------------------------------------------\n'
            printf '  %s-pooler:\n' "$MDB_ENGINE_NAME"
            # Its OWN profile, not a shared `pooler` one. Compose profiles
            # are OR: a shared profile starts every pooler, including those
            # whose engine was not selected, and compose then rejects the whole
            # project over the dangling depends_on. scripts/profiles expands
            # `pooler` into the ones that match the selected engines.
            printf '    profiles: [%s-pooler]\n' "$MDB_ENGINE_NAME"
            printf '    image: %s\n' "$MDB_ENGINE_POOLER_IMAGE"
            printf '    restart: unless-stopped\n'
            printf '    depends_on: [%s]\n' "$MDB_ENGINE_NAME"
            printf '    security_opt:\n      - no-new-privileges:true\n'
            printf '    cap_drop:\n      - ALL\n'
            # Every pooler starts through a bootstrap script from the
            # repository rather than an inline shell snippet in generated YAML.
            # The two poolers need genuinely different startup work -- pgBouncer
            # wants one credential in its environment, ProxySQL has to mirror
            # password verifiers through its admin interface -- and encoding
            # either of those as a `sh -c` string here would put engine
            # knowledge back into the generator.
            printf '    entrypoint: ["%s"]\n' "$MDB_ENGINE_POOLER_CMD"
            printf '    environment:\n'
            printf '      DB_PASSWORD_FILE: /run/secrets/%s\n' "${MDB_ENGINE_POOLER_SECRET:-pgbouncer_password.txt}"
            # Upstream host and port come from the descriptor, never from the
            # pooler config file, so the pooler cannot end up aimed at a
            # service name that no longer exists.
            printf '      DB_HOST: %s\n' "$MDB_ENGINE_NAME"
            printf '      DB_PORT: "%s"\n' "$MDB_ENGINE_PORT"
            cat "$MDB_ENGINE_DIR/compose-pooler.yml"
            # The pooler writes a generated userlist under /etc; tmpfs keeps it
            # off disk and out of any committed layer.
            printf '    tmpfs:\n      - %s:exec,mode=0700,uid=%s,gid=%s\n' \
                "${MDB_ENGINE_POOLER_STATE_DIR:-/tmp/pooler}" \
                "${MDB_ENGINE_POOLER_UID:-0}" "${MDB_ENGINE_POOLER_UID:-0}"
            printf '    volumes:\n'
            printf '      - ./secrets:/run/secrets:ro\n'
            printf '      - ./certs:/certs:ro\n'
            # Bootstrap scripts are baked into the images now, not mounted
            # from the repo -- an image that needs a file from the checkout to
            # start is not the standalone image SPEC section 3 promises.
            [ -n "${MDB_ENGINE_POOLER_BOOTSTRAP:-}" ] && \
                printf '      - ./%s:%s:ro\n' \
                    "$MDB_ENGINE_POOLER_BOOTSTRAP" "$MDB_ENGINE_POOLER_CMD"
            emit_ports "MDB_${upper}_POOLER_HOST_PORT" \
                "$(( MDB_ENGINE_PORT_OFFSET + 100 ))" "${MDB_ENGINE_POOLER_PORT:-6432}"
            printf '    networks: [mdb]\n'
            printf '    logging:\n      driver: json-file\n'
            printf '      options:\n'
            printf '        max-size: ${MDB_LOG_MAX_SIZE:-10m}\n'
            printf '        max-file: "${MDB_LOG_MAX_FILE:-3}"\n'
            printf '\n'
        } >> "$tmp"
        poolers=$(( poolers + 1 ))
    fi

    count=$(( count + 1 ))
done

# Volumes: per engine, per major. Pointing a new major at an old data directory
# fails hard, so the major is part of the name and versions coexist safely.
{
    printf 'volumes:\n'
    for engine in $(engine_list); do
        engine_load "$engine" || continue
        upper="$(printf '%s' "$MDB_ENGINE_NAME" | tr '[:lower:]-' '[:upper:]_')"
        printf '  %s_data:\n' "$MDB_ENGINE_NAME"
        printf '    name: ${COMPOSE_PROJECT_NAME:-mdb}_%s${MDB_%s_VERSION:-%s}_data\n' \
            "$MDB_ENGINE_NAME" "$upper" "$MDB_ENGINE_DEFAULT_VERSION"
        # NOT per major. The repository spans version upgrades: a backup taken
        # before an upgrade is exactly the one you want after a failed upgrade.
        if [ "${MDB_ENGINE_PITR_CAPABLE:-false}" = "true" ]; then
            # Neutral name: PostgreSQL's repository is pgBackRest's, the MySQL
            # family's is a binary-log directory. The volume is "where this
            # engine's point-in-time recovery data lives", not one tool's.
            printf '  %s_pitr:\n' "$MDB_ENGINE_NAME"
            printf '    name: ${COMPOSE_PROJECT_NAME:-mdb}_%s_pitr\n' "$MDB_ENGINE_NAME"
        fi
    done
} >> "$tmp"

mv "$tmp" "$OUT"

# -----------------------------------------------------------------------------
# Layer-4 routes for the front door
# -----------------------------------------------------------------------------
# Caddy proxies HTTP natively; database protocols are raw TCP, which is what
# caddy-l4 adds. Generated from the same descriptors as the services, so a new
# engine gets a proxy route by existing rather than by someone remembering.
#
# Written in every mode, empty unless MDB_PUBLISH=proxy: Caddy refuses to start
# on a missing import, and a front door that will not start is worse than one
# that forwards nothing.
L4="$ROOT/caddy/layer4.caddy"
{
    printf '# GENERATED by scripts/gen-compose. Do not edit.\n'
    # The routes live inside a `layer4` global option. Emitted bare they are
    # parsed as global options themselves, and Caddy refuses the whole config
    # with "unrecognized global option: :54004" -- which names the port rather
    # than the missing wrapper.
    if [ "$PUBLISH" = "proxy" ]; then
        printf 'layer4 {\n'
        for engine in $(engine_list); do
            engine_load "$engine" || continue
            [ -f "$ROOT/images/$MDB_ENGINE_NAME/Dockerfile" ] \
                || [ "${MDB_ENGINE_PUBLISH:-derive}" = "reference" ] || continue
            printf '\t# %s\n' "$MDB_ENGINE_TITLE"
            printf '\t%s {\n' ":$(( PORT_BASE + MDB_ENGINE_PORT_OFFSET ))"
            printf '\t\troute {\n'
            printf '\t\t\tproxy %s:%s\n' "$MDB_ENGINE_NAME" "$MDB_ENGINE_PORT"
            printf '\t\t}\n\t}\n'
        done
        printf '}\n'
    fi
} > "$L4"
printf 'generated %s\n' "${L4#"$ROOT"/}"

# The front door's own published ports, in proxy mode. Written as an override
# fragment rather than into docker-compose.yml, which is hand-written: the set
# of ports depends on which engines exist, and that is the generator's job.
CADDY_PORTS="$ROOT/compose.proxy.yml"
{
    printf '# GENERATED by scripts/gen-compose. Do not edit.\n'
    printf 'services:\n  caddy:\n'
    if [ "$PUBLISH" = "proxy" ]; then
        printf '    ports:\n'
        for engine in $(engine_list); do
            engine_load "$engine" || continue
            [ -f "$ROOT/images/$MDB_ENGINE_NAME/Dockerfile" ] \
                || [ "${MDB_ENGINE_PUBLISH:-derive}" = "reference" ] || continue
            printf '      - "${MDB_BIND_ADDR:-127.0.0.1}:%s:%s"\n' \
                "$(( PORT_BASE + MDB_ENGINE_PORT_OFFSET ))" \
                "$(( PORT_BASE + MDB_ENGINE_PORT_OFFSET ))"
        done
    else
        # A service key with no changes is valid YAML and keeps COMPOSE_FILE
        # stable across modes, so switching mode never edits .env.
        printf '    profiles: [ui, prod]\n'
    fi
} > "$CADDY_PORTS"
printf 'generated %s\n' "${CADDY_PORTS#"$ROOT"/}"
printf 'generated %s (%d engines, %d pooler(s))\n' "${OUT#"$ROOT"/}" "$count" "$poolers"
