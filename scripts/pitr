#!/usr/bin/env bash
#
# Point-in-time recovery for PostgreSQL (SPEC section 18, criterion 7c).
#
# PITR is the difference between losing up to a day and losing up to a
# transaction. A dump gives you the moment it ran; WAL archiving lets you stop
# recovery at any instant covered by the archive -- including the second before
# someone ran a DELETE without a WHERE clause.
#
# Usage:
#   scripts/pitr info                    repository state and recoverable window
#   scripts/pitr backup [--type full]    take a backup (default: incremental)
#   scripts/pitr restore --to '<ts>'     recover to a timestamp, typed confirmation
#   scripts/pitr restore --to latest     recover to the end of the archive

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 1

log() { printf '[pitr] %s\n' "$*"; }
die() { printf '[pitr] ERROR: %s\n' "$*" >&2; exit 1; }

ENV_FILE="${DBTK_ENV_FILE:-$ROOT/.env}"
[[ -f "$ENV_FILE" ]] || ENV_FILE="$ROOT/.env.example"
get() { grep -E "^${1}=" "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true; }

stanza="$(get DBTK_PGBACKREST_STANZA)"; stanza="${stanza:-dbtk}"
ENGINE=pg

verb="${1:-info}"
shift || true

TARGET=""
TYPE=incr
while (( $# )); do
    case "$1" in
        --to)     TARGET="${2:-}"; shift 2 ;;
        --type)   TYPE="${2:-}"; shift 2 ;;
        --engine) ENGINE="${2:-}"; shift 2 ;;
        *) die "unknown argument: $1" ;;
    esac
done

upper="$(printf '%s' "$ENGINE" | tr '[:lower:]-' '[:upper:]_')"
svc="$ENGINE"

pitr_enabled() {
    local v; v="$(get "DBTK_${upper}_PITR")"
    case "$v" in true|TRUE|1|yes|on) return 0 ;; *) return 1 ;; esac
}

# The MySQL family's binary log is the same idea as WAL archiving with entirely
# different tooling, so the verbs are shared and the implementations are not.
is_mysql_family() {
    case "$ENGINE" in mysql|mariadb) return 0 ;; *) return 1 ;; esac
}

mysql_client() { [ "$ENGINE" = mariadb ] && printf 'mariadb' || printf 'mysql'; }
# MariaDB ships mariadb-binlog; MySQL's minimal image ships no replay tool at
# all, which is why engines/mysql/engine.conf declares PITR_CAPABLE=false.
binlog_tool() { [ "$ENGINE" = mariadb ] && printf 'mariadb-binlog' || printf 'mysqlbinlog'; }
binlog_dir() {
    local d; d="$(get DBTK_BINLOG_DIR)"
    printf '%s' "${d:-/var/lib/dbtk-binlog}"
}
root_pw() { tr -d '\n' < "$ROOT/secrets/${ENGINE}_root_password.txt"; }

pitr_enabled || die "PITR is off for $ENGINE. Set DBTK_${upper}_PITR=true and restart:
       neither archive_mode nor log_bin can be enabled without one, so this is
       not a live toggle."

pgbr() { docker compose exec -T -u postgres "$svc" pgbackrest --stanza="$stanza" "$@"; }

# -----------------------------------------------------------------------------
# MySQL family: the binary log
# -----------------------------------------------------------------------------
if is_mysql_family; then
    client="$(mysql_client)"
    dir="$(binlog_dir)"

    my() {
        docker compose exec -T "$svc" "$client" --protocol=socket -uroot \
            -p"$(root_pw)" -N -B -e "$1" 2>/dev/null
    }

    # The coordinate-reporting statement was renamed. MariaDB 10.5.2 added
    # SHOW BINLOG STATUS; MySQL 8.4 uses SHOW BINARY LOG STATUS. Both keep the
    # old SHOW MASTER STATUS as a deprecated alias, so that is what is used
    # here rather than branching on a version.
    # Renamed in both directions: MySQL 8.4 REMOVED SHOW MASTER STATUS for
    # SHOW BINARY LOG STATUS, MariaDB added SHOW BINLOG STATUS and kept the old
    # name as an alias. Trying in order avoids branching on a version string.
    coordinate_now() {
        local out stmt
        for stmt in "SHOW BINARY LOG STATUS" "SHOW BINLOG STATUS" "SHOW MASTER STATUS"; do
            out="$(my "$stmt" 2>/dev/null || true)"
            if [ -n "$out" ]; then printf '%s' "$out" | awk '{print $1":"$2}'; return 0; fi
        done
        printf 'unknown'
    }

    # Files up to AND INCLUDING the one holding the target, in order.
    #
    # --stop-position applies only to the LAST file named, which is exactly the
    # behaviour wanted: everything before that file replays in full, and the
    # final file stops at the byte offset.
    files_through() {
        local target_file="$1" f out=""
        for f in $(docker compose exec -T "$svc" sh -c "ls -1 '$dir' 2>/dev/null" \
                    | tr -d '\r' | grep -E '^binlog\.[0-9]+$' | sort); do
            out="$out $dir/$f"
            [ "$f" = "$target_file" ] && break
        done
        printf '%s' "$out"
    }

    case "$verb" in
        info)
            log "binary logs in $dir (their own volume, not inside the data directory)"
            docker compose exec -T "$svc" sh -c "ls -lh '$dir' 2>/dev/null" || true
            printf '\n'
            log "current coordinate: $(coordinate_now)"
            printf '\n'
            log "recover with: make pitr-restore ENGINE=$ENGINE TO=<file>:<position>"
            log "the coordinate above is 'now'; earlier ones come from a dump's header"
            ;;

        backup)
            # A binlog is only replayable ONTO something. The base is an
            # ordinary dump, which already records its coordinates when PITR is
            # on, so this reuses that path rather than inventing a second kind
            # of backup that could drift from it.
            log "flushing binary logs so the current one is closed and complete"
            my "FLUSH BINARY LOGS" >/dev/null || die "FLUSH BINARY LOGS failed"
            log "taking the base dump (its binlog coordinate is recorded inside it)"
            "$ROOT/scripts/backup" --engine "$ENGINE" --all
            log "coordinate after backup: $(coordinate_now)"
            ;;

        restore)
            [[ -n "$TARGET" ]] || die "specify a target: --to <file>:<position>, or --to latest.
       Find coordinates with: make pitr-info ENGINE=$ENGINE"

            tool="$(binlog_tool)"

            # POSITIONS, not timestamps.
            #
            # mariadb-binlog with --stop-datetime across multiple files exits
            # after the FIRST file and silently skips the rest (MDEV-35528), so
            # a time-bounded replay quietly recovers almost nothing. Positions
            # are exact, have no second-granularity ambiguity and no timezone
            # interpretation, and --stop-position applies to the last file
            # named -- which is precisely the semantics needed.
            if [[ "$TARGET" == latest ]]; then
                stop_args=()
                target_file=""
            else
                target_file="${TARGET%%:*}"
                stop_pos="${TARGET##*:}"
                [[ "$target_file" != "$TARGET" && -n "$stop_pos" ]] \
                    || die "target must be <file>:<position>, for example binlog.000002:838"
                stop_args=(--stop-position="$stop_pos")
            fi

            printf 'Point-in-time recovery for %s replays the binary log onto a restored\n' "$ENGINE"
            printf 'dump, stopping at:\n\n    %s\n\n' "$TARGET"
            printf 'Restore the base dump FIRST (make restore ENGINE=%s DB=...), then run\n' "$ENGINE"
            printf 'this. Everything after the target is discarded.\n\n'
            printf 'Type %s to continue: ' "$ENGINE"
            read -r answer
            [[ "$answer" == "$ENGINE" ]] || die "confirmation did not match; nothing was changed"

            if [[ -n "$target_file" ]]; then
                logs="$(files_through "$target_file")"
                [[ "$logs" == *"$target_file"* ]] \
                    || die "no binary log named $target_file in $dir"
            else
                logs="$(files_through '')"
            fi
            [[ -n "$logs" ]] || die "no binary logs found in $dir"

            log "replaying:$logs"
            # shellcheck disable=SC2086  # $logs is a deliberate argument list
            docker compose exec -T "$svc" "$tool" ${stop_args[@]+"${stop_args[@]}"} $logs \
                > /tmp/dbtk-replay.$$.sql 2>/dev/null \
                || { rm -f "/tmp/dbtk-replay.$$.sql"; die "reading the binary log failed"; }

            docker compose exec -T "$svc" "$client" --protocol=socket -uroot -p"$(root_pw)" \
                < "/tmp/dbtk-replay.$$.sql" \
                || { rm -f "/tmp/dbtk-replay.$$.sql"; die "applying the binary log failed"; }
            rm -f "/tmp/dbtk-replay.$$.sql"

            log "replay complete; the database is at $TARGET"
            ;;

        *)
            die "unknown verb: $verb (want: info|backup|restore)"
            ;;
    esac
    exit 0
fi

case "$verb" in
    info)
        pgbr info
        printf '\n'
        # The recoverable window is what people actually want to know, and
        # `info` alone buries it. The oldest backup bounds how far back you can
        # go; the archive end bounds how far forward.
        log "recovery is possible from the oldest backup above to the end of the archive"
        ;;

    backup)
        case "$TYPE" in
            full|diff|incr) ;;
            *) die "unknown backup type '$TYPE' (want: full, diff or incr)" ;;
        esac
        log "taking a $TYPE backup"
        pgbr --type="$TYPE" backup
        log "done; verify with: make pitr-info"
        ;;

    restore)
        [[ -n "$TARGET" ]] || die "specify a target: --to '2026-08-09 12:34:56' or --to latest"

        printf 'This STOPS PostgreSQL and REPLACES its data directory with a recovery\n'
        printf 'to: %s\n\n' "$TARGET"
        printf 'Everything written after that point is discarded. If you are not sure the\n'
        printf 'target is right, restore into a copy instead -- see docs/RESTORE.md.\n\n'
        printf 'Type the stanza name (%s) to continue: ' "$stanza"
        read -r answer
        [[ "$answer" == "$stanza" ]] || die "confirmation did not match; nothing was changed"

        # PostgreSQL must be down: pgbackrest restore overwrites the data
        # directory, and doing that under a running server corrupts it.
        log "stopping PostgreSQL"
        docker compose stop "$svc" >/dev/null

        log "restoring"
        if [[ "$TARGET" == "latest" ]]; then
            docker compose run --rm --no-deps -u postgres "$svc" \
                pgbackrest --stanza="$stanza" --delta restore
        else
            docker compose run --rm --no-deps -u postgres "$svc" \
                pgbackrest --stanza="$stanza" --delta \
                --type=time --target="$TARGET" --target-action=promote restore
        fi

        log "starting PostgreSQL; it will replay WAL up to the target"
        docker compose start "$svc" >/dev/null
        log "recovery started. Watch it finish with: docker compose logs -f $svc"
        ;;

    *)
        die "unknown verb: $verb (want: info|backup|restore)"
        ;;
esac
