#!/usr/bin/env bash
#
# Point-in-time recovery for PostgreSQL (SPEC section 18, criterion 7c).
#
# PITR is the difference between losing up to a day and losing up to a
# transaction. A dump gives you the moment it ran; WAL archiving lets you stop
# recovery at any instant covered by the archive -- including the second before
# someone ran a DELETE without a WHERE clause.
#
# Usage:
#   scripts/pitr info                    repository state and recoverable window
#   scripts/pitr backup [--type full]    take a backup (default: incremental)
#   scripts/pitr restore --to '<ts>'     recover to a timestamp, typed confirmation
#   scripts/pitr restore --to latest     recover to the end of the archive

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 1

log() { printf '[pitr] %s\n' "$*"; }
die() { printf '[pitr] ERROR: %s\n' "$*" >&2; exit 1; }

ENV_FILE="${DBTK_ENV_FILE:-$ROOT/.env}"
[[ -f "$ENV_FILE" ]] || ENV_FILE="$ROOT/.env.example"
get() { grep -E "^${1}=" "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true; }

stanza="$(get DBTK_PGBACKREST_STANZA)"; stanza="${stanza:-dbtk}"
svc=pg

verb="${1:-info}"
shift || true

TARGET=""
TYPE=incr
while (( $# )); do
    case "$1" in
        --to)   TARGET="${2:-}"; shift 2 ;;
        --type) TYPE="${2:-}"; shift 2 ;;
        *) die "unknown argument: $1" ;;
    esac
done

pitr_enabled() {
    local v; v="$(get DBTK_PG_PITR)"
    case "$v" in true|TRUE|1|yes|on) return 0 ;; *) return 1 ;; esac
}

pitr_enabled || die "PITR is off. Set DBTK_PG_PITR=true and restart: archive_mode
       cannot be enabled without a server restart, so this is not a live toggle."

pgbr() { docker compose exec -T -u postgres "$svc" pgbackrest --stanza="$stanza" "$@"; }

case "$verb" in
    info)
        pgbr info
        printf '\n'
        # The recoverable window is what people actually want to know, and
        # `info` alone buries it. The oldest backup bounds how far back you can
        # go; the archive end bounds how far forward.
        log "recovery is possible from the oldest backup above to the end of the archive"
        ;;

    backup)
        case "$TYPE" in
            full|diff|incr) ;;
            *) die "unknown backup type '$TYPE' (want: full, diff or incr)" ;;
        esac
        log "taking a $TYPE backup"
        pgbr --type="$TYPE" backup
        log "done; verify with: make pitr-info"
        ;;

    restore)
        [[ -n "$TARGET" ]] || die "specify a target: --to '2026-08-09 12:34:56' or --to latest"

        printf 'This STOPS PostgreSQL and REPLACES its data directory with a recovery\n'
        printf 'to: %s\n\n' "$TARGET"
        printf 'Everything written after that point is discarded. If you are not sure the\n'
        printf 'target is right, restore into a copy instead -- see docs/RESTORE.md.\n\n'
        printf 'Type the stanza name (%s) to continue: ' "$stanza"
        read -r answer
        [[ "$answer" == "$stanza" ]] || die "confirmation did not match; nothing was changed"

        # PostgreSQL must be down: pgbackrest restore overwrites the data
        # directory, and doing that under a running server corrupts it.
        log "stopping PostgreSQL"
        docker compose stop "$svc" >/dev/null

        log "restoring"
        if [[ "$TARGET" == "latest" ]]; then
            docker compose run --rm --no-deps -u postgres "$svc" \
                pgbackrest --stanza="$stanza" --delta restore
        else
            docker compose run --rm --no-deps -u postgres "$svc" \
                pgbackrest --stanza="$stanza" --delta \
                --type=time --target="$TARGET" --target-action=promote restore
        fi

        log "starting PostgreSQL; it will replay WAL up to the target"
        docker compose start "$svc" >/dev/null
        log "recovery started. Watch it finish with: docker compose logs -f $svc"
        ;;

    *)
        die "unknown verb: $verb (want: info|backup|restore)"
        ;;
esac
