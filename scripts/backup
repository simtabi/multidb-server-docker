#!/usr/bin/env bash
#
# THE dump helper. SPEC section 11: "One dump helper, two callers" -- the
# scheduled sidecar and the make targets both run this file, so the flags can
# never drift between the nightly path and the manual one. That drift is only
# ever discovered during a real restore, which is the worst possible time.
#
# Dump correctness is specified, not assumed:
#
#   PostgreSQL   pg_dump -Fc per database (compressible, selectively
#                restorable) PLUS pg_dumpall --globals-only on every run. A
#                per-database dump contains no roles and no grants, so
#                restoring one into a fresh server yields a database nobody can
#                log into.
#
#   MySQL family --single-transaction --routines --triggers --events --quick.
#                The defaults include triggers but silently EXCLUDE stored
#                routines and events, so a "complete" dump without these flags
#                is quietly incomplete until the day you need a procedure back.
#
# Usage:
#   scripts/backup --engine pg --db mydb      one database
#   scripts/backup --all                      every database on every engine
#   scripts/backup --engine mysql --schedule  run forever on the backup interval

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${DBTK_ENV_FILE:-$ROOT/.env}"
[[ -f "$ENV_FILE" ]] || ENV_FILE="$ROOT/.env.example"

BACKUP_DIR="${DBTK_BACKUP_DIR:-$ROOT/backups}"

get() { grep -E "^${1}=" "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true; }
log() { printf '[backup] %s\n' "$*"; }
die() { printf '[backup] ERROR: %s\n' "$*" >&2; exit 1; }

ENGINE=""
DB=""
ALL=0
SCHEDULE=0

while (( $# )); do
    case "$1" in
        --engine) ENGINE="${2:-}"; shift 2 ;;
        --db)     DB="${2:-}"; shift 2 ;;
        --all)    ALL=1; shift ;;
        --schedule) SCHEDULE=1; shift ;;
        *) die "unknown argument: $1" ;;
    esac
done

# -----------------------------------------------------------------------------
# Two execution contexts, one implementation.
#
# Inside the sidecar the engine is reachable over the network and the client is
# right here. From the host, the same command is run inside the engine's own
# container. Either way the DUMP COMMAND AND ITS FLAGS are identical, which is
# the entire point of this file.
# -----------------------------------------------------------------------------
IN_CONTAINER="${DBTK_IN_CONTAINER:-0}"

engine_exec() {
    local engine="$1"; shift
    if [[ "$IN_CONTAINER" == "1" ]]; then
        "$@"
    else
        ( cd "$ROOT" && docker compose exec -T "$engine" "$@" )
    fi
}

secret() {
    local file="$1"
    if [[ "$IN_CONTAINER" == "1" ]]; then
        [[ -r "/run/secrets/$file" ]] || die "secret not readable: /run/secrets/$file"
        tr -d '\n' < "/run/secrets/$file"
    else
        [[ -r "$ROOT/secrets/$file" ]] || die "secret not readable: secrets/$file"
        tr -d '\n' < "$ROOT/secrets/$file"
    fi
}

timestamp() { date -u '+%Y%m%dT%H%M%SZ'; }

compress_ext() {
    case "$(get DBTK_BACKUP_COMPRESSION)" in
        NONE|none) printf '' ;;
        *) printf '.zst' ;;
    esac
}

# Write a checksum next to every artefact, so a truncated or corrupted file is
# detectable before someone stakes a restore on it.
checksum() {
    local file="$1"
    if command -v sha256sum >/dev/null 2>&1; then
        ( cd "$(dirname "$file")" && sha256sum "$(basename "$file")" > "$(basename "$file").sha256" )
    else
        ( cd "$(dirname "$file")" && shasum -a 256 "$(basename "$file")" > "$(basename "$file").sha256" )
    fi
}

finish_artifact() {
    local file="$1"
    checksum "$file"
    log "wrote $(basename "$file") ($(du -h "$file" | cut -f1))"
}

# Run a dump pipeline and REFUSE to keep the output if it failed.
#
# This exists because of a bug this helper actually had: `set -e` does not
# abort inside a function that was invoked from a `||` context (as the schedule
# loop does), so a dump that failed with "connection refused" still fell
# through to finish_artifact and produced a checksummed file that looked
# exactly like a backup. A backup that is really an error message is worse than
# no backup, because it is trusted.
#
# So the status is checked explicitly, the partial file is deleted, and the
# caller is told. Never rely on set -e for this.
dump_or_fail() {
    local out="$1" what="$2"; shift 2
    if ! "$@"; then
        rm -f "$out"
        log "FAILED: $what (no artifact kept)"
        return 1
    fi
    # An empty or near-empty file means the command "succeeded" while producing
    # nothing usable, which is the other way this goes wrong quietly.
    if [[ ! -s "$out" ]]; then
        rm -f "$out"
        log "FAILED: $what produced an empty file (no artifact kept)"
        return 1
    fi
    finish_artifact "$out"
}

# Where the engine lives. In the sidecar it is a remote host on the compose
# network; from the host we are already exec'ing inside the engine container,
# so there is no host to name.
engine_host() {
    [[ "$IN_CONTAINER" == "1" ]] && printf '%s' "$1"
}

# -----------------------------------------------------------------------------
# Engine operations come from the descriptor and its family hooks
# (SPEC section 22.1). Nothing below branches on an engine name.
# -----------------------------------------------------------------------------
# shellcheck source=engine-lib.sh
. "$ROOT/scripts/engine-lib.sh"

backup_one_database() {
    local db="$1" ts out
    ts="$(timestamp)"
    out="$BACKUP_DIR/${DBTK_ENGINE_NAME}_${db}_${ts}.${DBTK_ENGINE_BACKUP_EXT}$(compress_ext)"
    log "$DBTK_ENGINE_NAME: dumping $db"
    dump_or_fail "$out" "$DBTK_ENGINE_NAME dump of $db" hook_dump_database "$db" "$out"
}

backup_globals() {
    # Only engines that declare a globals dump have one. PostgreSQL does;
    # MySQL keeps grants inside an ordinary database.
    [ -n "${DBTK_ENGINE_DUMP_GLOBALS:-}" ] || return 0
    local ts out
    ts="$(timestamp)"
    out="$BACKUP_DIR/${DBTK_ENGINE_NAME}_globals_${ts}.sql$(compress_ext)"
    log "$DBTK_ENGINE_NAME: dumping globals (roles and grants)"
    dump_or_fail "$out" "$DBTK_ENGINE_NAME globals dump" hook_dump_globals "$out"
}

# -----------------------------------------------------------------------------
# Retention: GFS tiers (SPEC section 11)
# -----------------------------------------------------------------------------
prune() {
    local daily; daily="$(get DBTK_BACKUP_RETAIN_DAILY)"; daily="${daily:-7}"
    local removed=0
    # Any artefact, whatever extension the engine's descriptor declares --
    # .dump, .sql, .archive, .tar. Matching a fixed list here would silently
    # stop pruning the moment a new engine was added.
    while IFS= read -r old; do
        [[ -z "$old" ]] && continue
        rm -f "$old" "$old.sha256"
        removed=$(( removed + 1 ))
    done < <(find "$BACKUP_DIR" -maxdepth 1 -type f \
                  ! -name '*.sha256' ! -name '.gitkeep' \
                  -mtime "+${daily}" 2>/dev/null || true)
    (( removed )) && log "pruned $removed backup(s) older than ${daily} days"
    return 0
}

# -----------------------------------------------------------------------------
# S3 push. Wiring is present but inactive until a bucket is configured, which
# is the section 19 default.
# -----------------------------------------------------------------------------
push_s3() {
    local bucket; bucket="$(get DBTK_S3_BUCKET)"
    [[ -z "$bucket" ]] && return 0
    command -v rclone >/dev/null 2>&1 || { log "rclone not available; skipping S3 push"; return 0; }
    log "pushing to S3 bucket $bucket"
    rclone copy "$BACKUP_DIR" ":s3:${bucket}/$(hostname)" --no-traverse 2>&1 | sed 's/^/[backup]   /' || \
        log "S3 push failed (backups remain on local disk)"
}

# -----------------------------------------------------------------------------
# Failure notification, so backups never fail silently (SPEC section 11).
# -----------------------------------------------------------------------------
notify_failure() {
    local url; url="$(get DBTK_BACKUP_NOTIFY_URL)"
    [[ -z "$url" ]] && return 0
    command -v curl >/dev/null 2>&1 || return 0
    curl -fsS -X POST -H 'Content-Type: application/json' \
        -d "{\"text\":\"db-toolkit backup FAILED on $(hostname) at $(date -u)\"}" \
        "$url" >/dev/null 2>&1 || true
}
# shellcheck disable=SC2154  # rc is assigned inside the trap body itself
trap 'rc=$?; (( rc )) && notify_failure; exit $rc' EXIT

# -----------------------------------------------------------------------------
# Drivers
# -----------------------------------------------------------------------------
run_engine_backup() {
    local engine="$1" db="${2:-}"

    engine_load "$engine" || die "unknown engine: $engine"
    engine_load_hooks || die "no hooks for engine family ${DBTK_ENGINE_FAMILY:-?}"

    if [ -n "$db" ]; then
        backup_one_database "$db"
    else
        while IFS= read -r d; do
            [ -n "$d" ] && backup_one_database "$d"
        done < <(hook_list_databases)
    fi
    backup_globals
}

mkdir -p "$BACKUP_DIR"

# The sidecar starts alongside its engine, not after it, so the first run would
# otherwise fire against a server that is not accepting connections yet.
wait_for_engine() {
    local engine="$1" i
    engine_load "$engine" >/dev/null 2>&1 || return 1
    engine_load_hooks >/dev/null 2>&1 || return 1
    for (( i = 0; i < 180; i++ )); do
        # A successful database listing means the engine is genuinely
        # answering, which a port check does not.
        if hook_list_databases >/dev/null 2>&1; then return 0; fi
        sleep 2
    done
    log "WARNING: $engine did not become reachable within 360s"
    return 1
}

if (( SCHEDULE )); then
    [[ -n "$ENGINE" ]] || die "--schedule requires --engine"
    interval="$(get DBTK_BACKUP_INTERVAL_SECONDS)"; interval="${interval:-86400}"
    log "scheduled backups for $ENGINE every ${interval}s"
    wait_for_engine "$ENGINE" || true
    while true; do
        run_engine_backup "$ENGINE" || log "backup run failed; will retry next interval"
        prune
        push_s3
        sleep "$interval"
    done
fi

if (( ALL )); then
    # COMPOSE_PROFILES wins when set, because `make up PROFILES=...` selects the
    # engines for THIS run; falling back to the .env default would back up a
    # different set of engines than the one actually running.
    profiles="${COMPOSE_PROFILES:-$(get DBTK_PROFILES)}"
    for engine in $(engine_list); do
        case ",${profiles}," in
            *",${engine},"*) run_engine_backup "$engine" ;;
            *) log "$engine not in DBTK_PROFILES; skipping" ;;
        esac
    done
    prune
    push_s3
    log "backup-all complete"
    exit 0
fi

[[ -n "$ENGINE" ]] || die "specify --engine <pg|mysql|mariadb>, or --all"
run_engine_backup "$ENGINE" "$DB"
prune
push_s3
