#!/usr/bin/env bash
#
# Guided major-version migration (SPEC section 4).
#
# The dump-and-restore path, which is the default because it is the one that
# always works: it crosses any version gap, it is verifiable before you commit
# to it, and the OLD VOLUME IS NEVER TOUCHED. Per-major volumes (decision 2)
# are what make that true -- the old major keeps its own volume, so a failed
# upgrade is a non-event and rollback is changing one line in .env back.
#
# pg_upgrade --link is faster on large datasets and is documented in
# docs/UPGRADE.md as the manual path; it is not automated here because it
# mutates the source data directory, which would throw away that guarantee.
#
# Usage: scripts/upgrade --engine pg --from 16 --to 17

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 1

PROJECT="${COMPOSE_PROJECT_NAME:-mdb}"
PREFIX="${MDB_IMAGE_PREFIX:-ghcr.io/simtabi}"
WORK="$ROOT/backups/upgrade"

log() { printf '[upgrade] %s\n' "$*"; }
die() { printf '[upgrade] ERROR: %s\n' "$*" >&2; exit 1; }

ENGINE=""; FROM=""; TO=""
ENGINE_UPPER=""
while (( $# )); do
    case "$1" in
        --engine) ENGINE="${2:-}"; shift 2 ;;
        --from)   FROM="${2:-}"; shift 2 ;;
        --to)     TO="${2:-}"; shift 2 ;;
        *) die "unknown argument: $1" ;;
    esac
done

[[ -n "$ENGINE" && -n "$FROM" && -n "$TO" ]] \
    || die "usage: make upgrade ENGINE=pg FROM=16 TO=17"
[[ "$FROM" != "$TO" ]] || die "FROM and TO are the same version"

case "$ENGINE" in
    pg)      vol_from="${PROJECT}_pg${FROM}_data";      vol_to="${PROJECT}_pg${TO}_data" ;;
    mysql)   vol_from="${PROJECT}_mysql${FROM}_data";   vol_to="${PROJECT}_mysql${TO}_data" ;;
    mariadb) vol_from="${PROJECT}_mariadb${FROM}_data"; vol_to="${PROJECT}_mariadb${TO}_data" ;;
    *) die "unknown engine: $ENGINE" ;;
esac

# tr rather than ${ENGINE^^}: that expansion is bash 4 only and macOS ships
# bash 3.2, where it is a syntax error (DESIGN.md D-24).
ENGINE_UPPER="$(printf '%s' "$ENGINE" | tr '[:lower:]' '[:upper:]')"

docker volume inspect "$vol_from" >/dev/null 2>&1 \
    || die "no data volume for $ENGINE $FROM ($vol_from); nothing to upgrade from"

# Both images must already be local. Without this the first docker run tries to
# pull from a private registry and fails with a bare "denied", which says
# nothing about what is actually wrong.
for v in "$FROM" "$TO"; do
    img="$PREFIX/multidb-server-$ENGINE:$v"
    docker image inspect "$img" >/dev/null 2>&1 \
        || die "image not built: $img
       Build it first:  MDB_${ENGINE_UPPER}_VERSION=$v scripts/build $ENGINE"
done

cat <<PLAN

Upgrade plan
────────────────────────────────────────────────────────────────────────
  engine        ${ENGINE}
  from          ${FROM}   (volume ${vol_from})
  to            ${TO}     (volume ${vol_to})
  method        dump and restore

  The ${FROM} volume is NEVER modified. If anything goes wrong, set
  MDB_${ENGINE_UPPER}_VERSION back to ${FROM} in .env and you are exactly
  where you started.
────────────────────────────────────────────────────────────────────────

PLAN

if [[ "${CONFIRM:-}" != "yes" ]]; then
    printf 'Type the target version (%s) to continue: ' "$TO"
    read -r answer
    [[ "$answer" == "$TO" ]] || die "confirmation did not match; nothing was changed"
fi

mkdir -p "$WORK"
stamp="$(date -u '+%Y%m%dT%H%M%SZ')"

old_c="mdb-upgrade-from-$$"
new_c="mdb-upgrade-to-$$"
cleanup() { docker rm -f "$old_c" "$new_c" >/dev/null 2>&1 || true; }
trap cleanup EXIT

# ---------------------------------------------------------------------------
# 1. Dump from the old major, in an isolated container so the running stack is
#    untouched.
# ---------------------------------------------------------------------------
log "starting $ENGINE $FROM against its existing volume (read only as far as your data is concerned)"

case "$ENGINE" in
    pg)
        docker run -d --name "$old_c" -e POSTGRES_PASSWORD=mdb-throwaway-upgrade \
            -v "$vol_from:/var/lib/postgresql/data" "$PREFIX/multidb-server-pg:$FROM" >/dev/null \
            || die "could not start $ENGINE $FROM"
        for _ in $(seq 1 120); do
            docker exec "$old_c" pg_isready -U postgres >/dev/null 2>&1 && break
            sleep 1
        done
        sleep 3

        dump="$WORK/${ENGINE}${FROM}_all_${stamp}.sql"
        log "dumping every database and the globals"
        docker exec "$old_c" pg_dumpall -U postgres > "$dump" \
            || die "dump failed; nothing has been changed"
        ;;
    mysql|mariadb)
        pw_env="$( [[ "$ENGINE" == mysql ]] && printf 'MYSQL_ROOT_PASSWORD' || printf 'MARIADB_ROOT_PASSWORD' )"
        client="$( [[ "$ENGINE" == mysql ]] && printf 'mysql' || printf 'mariadb' )"
        dumper="$( [[ "$ENGINE" == mysql ]] && printf 'mysqldump' || printf 'mariadb-dump' )"
        root_pw="$(cat "secrets/${ENGINE}_root_password.txt")"

        docker run -d --name "$old_c" -e "$pw_env=$root_pw" \
            -v "$vol_from:/var/lib/mysql" "$PREFIX/multidb-server-$ENGINE:$FROM" >/dev/null \
            || die "could not start $ENGINE $FROM"
        for _ in $(seq 1 180); do
            docker exec "$old_c" "$client" -uroot -p"$root_pw" -e "SELECT 1" >/dev/null 2>&1 && break
            sleep 1
        done

        dump="$WORK/${ENGINE}${FROM}_all_${stamp}.sql"
        log "dumping every database, with routines and events"
        docker exec "$old_c" "$dumper" -uroot -p"$root_pw" \
            --all-databases --single-transaction --routines --triggers --events --quick \
            > "$dump" 2>/dev/null || die "dump failed; nothing has been changed"
        ;;
esac

[[ -s "$dump" ]] || die "the dump is empty; refusing to continue"
log "dumped $(du -h "$dump" | cut -f1) to ${dump#"$ROOT"/}"
docker rm -f "$old_c" >/dev/null 2>&1 || true

# ---------------------------------------------------------------------------
# 2. Restore into a fresh volume for the new major.
# ---------------------------------------------------------------------------
log "starting $ENGINE $TO on a fresh volume"

case "$ENGINE" in
    pg)
        docker run -d --name "$new_c" -e POSTGRES_PASSWORD=mdb-throwaway-upgrade \
            -v "$vol_to:/var/lib/postgresql/data" "$PREFIX/multidb-server-pg:$TO" >/dev/null \
            || die "could not start $ENGINE $TO"
        for _ in $(seq 1 120); do
            docker exec "$new_c" pg_isready -U postgres >/dev/null 2>&1 && break
            sleep 1
        done
        sleep 3
        log "restoring"
        docker exec -i "$new_c" psql -U postgres -q < "$dump" >/dev/null 2>&1 || true

        count="$(docker exec "$new_c" psql -U postgres -tAc \
            "SELECT count(*) FROM pg_database WHERE datallowconn AND NOT datistemplate" | tr -d ' ')"
        ;;
    mysql|mariadb)
        docker run -d --name "$new_c" -e "$pw_env=$root_pw" \
            -v "$vol_to:/var/lib/mysql" "$PREFIX/multidb-server-$ENGINE:$TO" >/dev/null \
            || die "could not start $ENGINE $TO"
        for _ in $(seq 1 180); do
            docker exec "$new_c" "$client" -uroot -p"$root_pw" -e "SELECT 1" >/dev/null 2>&1 && break
            sleep 1
        done
        log "restoring"
        docker exec -i "$new_c" "$client" -uroot -p"$root_pw" < "$dump" >/dev/null 2>&1 || true

        count="$(docker exec "$new_c" "$client" -uroot -p"$root_pw" -N -B -e \
            "SELECT count(*) FROM information_schema.schemata
             WHERE schema_name NOT IN ('information_schema','performance_schema','mysql','sys')" \
             2>/dev/null | tr -d ' \r')"
        ;;
esac

if [[ -z "$count" ]] || (( count == 0 )); then
    die "the upgraded server has no databases; the OLD volume $vol_from is untouched, so nothing is lost"
fi

log "$count database(s) present on $ENGINE $TO"

cat <<DONE

────────────────────────────────────────────────────────────────────────
Upgrade staged successfully.

  1. Set MDB_${ENGINE_UPPER}_VERSION=${TO} in .env
  2. make up
  3. Verify your application

  The ${FROM} data is still in ${vol_from}. Keep it until you are sure.
  To roll back: set the version back to ${FROM} and make up.
  To reclaim the space later: make destroy --volume ${vol_from}

  The intermediate dump is at ${dump#"$ROOT"/}
────────────────────────────────────────────────────────────────────────
DONE
