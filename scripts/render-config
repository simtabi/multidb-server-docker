#!/usr/bin/env bash
#
# Render every templated file through scripts/env-render, which is the single
# interpolation path (SPEC section 13).
#
# Run automatically by `make up`, so a fresh clone never boots against a stale
# or missing rendered file.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 1

ENV_FILE="${MDB_ENV_FILE:-$ROOT/.env}"
[[ -f "$ENV_FILE" ]] || ENV_FILE="$ROOT/.env.example"

profiles="${COMPOSE_PROFILES:-$(grep -E '^MDB_PROFILES=' "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true)}"
profiles="${profiles:-pg,ui}"

# Dev and prod are separate templates rather than one file full of
# conditionals: prod requires an ACME email and a basic-auth hash, and
# env-render fails loudly if either is missing, which is the behaviour we want
# for a UI that would otherwise be published with no password.
if [[ ",${profiles}," == *",prod,"* ]]; then
    caddy_template="caddy/Caddyfile.prod.tmpl"
else
    caddy_template="caddy/Caddyfile.tmpl"
fi

MDB_ENV_FILE="$ENV_FILE" "$ROOT/scripts/env-render" "$caddy_template" "$ROOT/caddy/Caddyfile"
MDB_ENV_FILE="$ENV_FILE" "$ROOT/scripts/env-render" "caddy/servers.json.tmpl" "$ROOT/caddy/servers.json"

# -----------------------------------------------------------------------------
# Normalise the one secret whose mode must differ
# -----------------------------------------------------------------------------
# pgAdmin reads its secret as uid 5050 with no root phase, and compose ignores
# uid/gid/mode on file-backed secrets (docker/compose#9648), so the HOST mode is
# what the container sees. init generates it 0644 now -- but init refuses to run
# on an existing checkout, so anyone who initialised before that change keeps an
# 0600 file and a crash-looping pgAdmin. This runs on every make up and heals
# it. secrets/ stays 0700, which is the actual guard on the host.
if [[ -f "$ROOT/secrets/pgadmin_password.txt" ]]; then
    chmod 0644 "$ROOT/secrets/pgadmin_password.txt"
fi
