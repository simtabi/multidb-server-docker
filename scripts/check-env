#!/usr/bin/env bash
#
# Validate the environment before anything is allowed to start.
#
# SPEC decision 6 and section 9: this refuses to let the stack boot with
# sentinel passwords. SPEC section 21.1 adds the prod guards. A check-env that
# a placeholder can satisfy is not a gate, so every rule here fails closed.
#
# Usage: scripts/check-env [--quiet]
#        MDB_ENV_FILE=path/to/.env scripts/check-env

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${MDB_ENV_FILE:-$ROOT/.env}"
QUIET=0
[[ "${1:-}" == "--quiet" ]] && QUIET=1

if [[ ! -f "$ENV_FILE" ]]; then
    if [[ -f "$ROOT/.env.example" ]]; then
        ENV_FILE="$ROOT/.env.example"
    else
        printf 'check-env: no .env and no .env.example found\n' >&2
        exit 1
    fi
fi

if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]]; then
    RED=$'\033[31m'; GRN=$'\033[32m'; OFF=$'\033[0m'
else
    RED=''; GRN=''; OFF=''
fi

errors=0
err()  { printf '%scheck-env%s %s\n' "$RED" "$OFF" "$1" >&2; (( errors++ )) || true; }
note() { (( QUIET )) || printf '  %s\n' "$1"; }

# Read a key's value from the env file, ignoring comments.
get() {
    grep -E "^${1}=" "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true
}

# -----------------------------------------------------------------------------
# 1. Sentinels and plaintext passwords
# -----------------------------------------------------------------------------
while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ "$line" =~ ^[[:space:]]*$ ]] && continue

    key="${line%%=*}"
    value="${line#*=}"
    [[ "$key" == "$line" ]] && continue

    # Sentinel values anywhere are fatal.
    case "$value" in
        *CHANGE_ME*|*CHANGEME*|*REPLACE_ME*|*your-password-here*|*TODO*)
            err "$key still holds a sentinel value ($value)"
            continue
            ;;
    esac

    # A password-ish key must be a _FILE reference, never a literal.
    case "$key" in
        *_PASSWORD_FILE|*_SECRET_FILE|*_KEY_ID_FILE|*_PASSPHRASE_FILE)
            : # correct form
            ;;
        *PASSWORD|*PASSWD|*_SECRET|*PASSPHRASE|*ACCESS_KEY|*PRIVATE_KEY)
            if [[ -n "$value" ]]; then
                err "$key holds a literal value; use ${key}_FILE and a file under secrets/"
            fi
            ;;
    esac
done < "$ENV_FILE"

# -----------------------------------------------------------------------------
# 2. Required variables
# -----------------------------------------------------------------------------
for key in COMPOSE_PROJECT_NAME MDB_PROFILES MDB_TZ MDB_BIND_ADDR \
           MDB_PG_VERSION MDB_MYSQL_VERSION MDB_MARIADB_VERSION; do
    [[ -n "$(get "$key")" ]] || err "$key is required but unset"
done

# -----------------------------------------------------------------------------
# 3. Engine versions must be on the supported menu (SPEC section 4)
# -----------------------------------------------------------------------------
check_menu() {
    local key="$1" value; shift
    value="$(get "$key")"
    [[ -z "$value" ]] && return 0
    local allowed=" $* "
    [[ "$allowed" == *" $value "* ]] || err "$key=$value is not on the supported menu: $*"
}
# The supported menu comes from each engine's descriptor, so adding an engine
# or a version does not require editing this file (SPEC section 22.1).
# shellcheck source=engine-lib.sh
. "$ROOT/scripts/engine-lib.sh"

for _engine in $(engine_list); do
    engine_load "$_engine" || continue
    _upper="$(printf '%s' "$MDB_ENGINE_NAME" | tr '[:lower:]-' '[:upper:]_')"
    # Unquoted on purpose: VERSIONS is a space-separated menu and check_menu
    # takes each version as its own argument.
    # shellcheck disable=SC2086
    check_menu "MDB_${_upper}_VERSION" $MDB_ENGINE_VERSIONS
done

# PostgreSQL 18 moved the expected mount point. Up to 17 the data directory is
# /var/lib/postgresql/data; from 18 the image stores data in major-versioned
# subdirectories and expects the volume one level up at /var/lib/postgresql, so
# that pg_upgrade --link can work across majors.
#
# Getting this pair wrong does not fail loudly at boot -- it silently
# initialises a second, empty database in the wrong place -- so it is checked
# here rather than discovered later.
pg_version="$(get MDB_PG_VERSION)"
pg_mount="$(get MDB_PG_DATA_MOUNT)"
if [[ -n "$pg_version" && -n "$pg_mount" ]]; then
    if (( ${pg_version%%.*} >= 18 )); then
        [[ "$pg_mount" == "/var/lib/postgresql" ]] \
            || err "MDB_PG_VERSION=$pg_version needs MDB_PG_DATA_MOUNT=/var/lib/postgresql (got $pg_mount)"
    else
        [[ "$pg_mount" == "/var/lib/postgresql/data" ]] \
            || err "MDB_PG_VERSION=$pg_version needs MDB_PG_DATA_MOUNT=/var/lib/postgresql/data (got $pg_mount)"
    fi
fi

# -----------------------------------------------------------------------------
# 4. Host port collisions
# -----------------------------------------------------------------------------
# bash 3.2 has no associative arrays (macOS ships 3.2), so collisions are
# tracked in a plain string of "port:key " pairs.
seen_ports=""
while IFS= read -r line; do
    key="${line%%=*}"; value="${line#*=}"
    [[ -z "$value" ]] && continue
    case " $seen_ports " in
        *" ${value}:"*)
            prior="${seen_ports##*" ${value}:"}"
            prior="${prior%% *}"
            err "port $value is claimed by both $prior and $key"
            ;;
        *)
            seen_ports="$seen_ports ${value}:${key}"
            ;;
    esac
done < <(grep -E '^MDB_[A-Z0-9_]*(HOST_)?PORT=' "$ENV_FILE" 2>/dev/null || true)

# -----------------------------------------------------------------------------
# 4b. HA and standalone cannot both own the PostgreSQL port
# -----------------------------------------------------------------------------
# The collision above only compares values WRITTEN in the env file, and
# MDB_PG_HOST_PORT is commented out by default -- the generated compose still
# publishes 5432 for it. So `PROFILES=pg,ha` binds 5432 twice, once for the
# standalone engine and once for HAProxy, and the only symptom is a Docker
# "port is already allocated" at the end of an otherwise successful boot.
#
# Effective values, not written ones, is the point: a default that collides is
# still a collision.
ha_profiles="$(get MDB_PROFILES)"
if [[ ",${MDB_CHECK_PROFILES:-$ha_profiles}," == *",ha,"* ]]; then
    pg_port="$(get MDB_PG_HOST_PORT)"; pg_port="${pg_port:-5432}"
    hap_w="$(get MDB_HAPROXY_WRITE_PORT)"; hap_w="${hap_w:-5432}"
    hap_r="$(get MDB_HAPROXY_READ_PORT)"; hap_r="${hap_r:-5433}"

    if [[ ",${MDB_CHECK_PROFILES:-$ha_profiles}," == *",pg,"* ]]; then
        if [[ "$pg_port" == "$hap_w" || "$pg_port" == "$hap_r" ]]; then
            err "profiles 'pg' and 'ha' both publish port $pg_port.
       HA replaces the standalone engine rather than joining it -- run
       PROFILES=ha, or set MDB_PG_HOST_PORT to something else."
        fi
    fi

    [[ "$hap_w" == "$hap_r" ]] \
        && err "MDB_HAPROXY_WRITE_PORT and MDB_HAPROXY_READ_PORT are both $hap_w"

    etcd_hosts="$(get MDB_HA_ETCD_HOSTS)"
    members="$(awk -F, '{print NF}' <<< "$etcd_hosts")"
    (( members >= 3 )) \
        || err "MDB_HA_ETCD_HOSTS lists $members endpoint(s); a quorum needs 3 minimum (SPEC 21.2)"
fi

# -----------------------------------------------------------------------------
# 4c. Ports already taken on the HOST
# -----------------------------------------------------------------------------
# Section 4 compares ports against each other. It cannot see the rest of the
# machine, so a port held by anything else -- another project's Adminer, a
# native PostgreSQL, an unrelated container -- gets past it and fails much
# later, as a Docker error at the end of an otherwise successful boot:
#
#   Bind for 127.0.0.1:8080 failed: port is already allocated
#
# That names neither the setting to change nor the process holding it. Catching
# it here turns it into one line, before anything starts.
#
# Ports our OWN stack already publishes are fine: `make up` on a running stack
# rebinds them, and erroring on that would make the command unrepeatable.
# Validating the ACTIVE .env means a boot is imminent, so host state matters.
# Validating .env.example or a freshly rendered .env.prod is a question about
# the FILE: it binds nothing, and the machine holding a port here is often not
# the machine that will run it. Deriving this from the filename means no caller
# has to remember a flag -- check 06 validates the template, check 26 validates
# a render, and both were failing on ports neither of them was about to bind.
# The filename sets the DEFAULT; an explicit MDB_CHECK_RENDERING still wins,
# so a caller can ask "would this file boot?" of a file that is not .env --
# which is exactly what check 26 does to prove the deferred credential
# requirement is enforced somewhere rather than merely deferred.
if [[ -z "${MDB_CHECK_RENDERING:-}" ]]; then
    case "$(basename "$ENV_FILE")" in
        .env) MDB_CHECK_RENDERING=0 ;;
        *)    MDB_CHECK_RENDERING=1 ;;
    esac
fi

ours=""
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    # Space separated, not newline: the membership test below compares
    # " $ours " against *" $value "*, and newlines make every match fail.
    ours="$(docker ps --filter "label=com.docker.compose.project=${COMPOSE_PROJECT_NAME:-mdb}" \
             --format '{{.Ports}}' 2>/dev/null | grep -oE '[0-9]+->' | tr -d '>-' \
             | sort -u | tr '\n' ' ' || true)"
fi

# Only ports that will actually be published. A port belonging to a profile
# nobody selected is not a collision -- flagging HAProxy's 5433 when HA is off
# would train people to ignore this check, which is worse than not having it.
# COMPOSE_PROFILES first: the Makefile has already resolved PROFILES= from the
# command line, MDB_PROFILES from the file, and the default. Reading the file
# directly ignores `make up PROFILES=pg` and judges ports for services that run
# that are not about to start -- which failed nine checks with "make up failed":
# because another project held 443 and `pg` does not publish 443.
active_profiles=",${COMPOSE_PROFILES:-${MDB_CHECK_PROFILES:-$(get MDB_PROFILES)}},"
port_is_active() {
    case "$1" in
        MDB_HAPROXY_*)  [[ "$active_profiles" == *,ha,* ]] ;;
        MDB_CADDY_*|MDB_ADMINER_*|MDB_PGADMIN_*|MDB_PMA_*|MDB_UI_*)
                         [[ "$active_profiles" == *,ui,* || "$active_profiles" == *,prod,* ]] ;;
        MDB_*_POOLER_HOST_PORT)
                         [[ "$active_profiles" == *,pooler,* ]] ;;
        MDB_*_HOST_PORT)
            local eng; eng="$(printf '%s' "$1" | sed -E 's/^MDB_//; s/_HOST_PORT$//' \
                              | tr '[:upper:]_' '[:lower:]-')"
            [[ "$active_profiles" == *,"$eng",* ]] ;;
        *) return 1 ;;
    esac
}

port_in_use() {
    # bash's /dev/tcp needs no external tool, which matters because this runs
    # on macOS, Linux and inside containers with different utilities available.
    (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null && { exec 3<&-; return 0; } || return 1
}

# Ports come from COMPOSE, not from the env file.
#
# The file only carries the ones an operator has uncommented; every other
# published port is a default baked into the compose files
# (${MDB_ADMINER_HOST_PORT:-8080}). Scanning the file therefore missed exactly
# the collisions that actually happen -- Adminer on 8080 is the single most
# contended port on a developer machine, and it slipped through because nobody
# had written it down. `compose config` resolves every default and every
# profile, which is the same thing `make up` is about to bind.
taken=""
resolved=""
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    # The SAME profiles that are about to start. Without them compose reports
    # every service in every profile, so HAProxy's 5433 gets flagged when HA is
    # off -- a false alarm that teaches people to ignore this check.
    prof_args=()
    for _p in ${active_profiles//,/ }; do
        [[ -n "$_p" ]] && prof_args+=(--profile "$_p")
    done

    # ${a[@]+"${a[@]}"} because bash 3.2 with set -u errors on an empty array,
    # and macOS ships bash 3.2 -- the same idiom the rest of this repo uses.
    # A subshell that cd's and then runs, rather than `cd && cmd`: the latter
    # reads as if-then-else to shellcheck (SC2015) and the trailing || would
    # fire on a cd failure too.
    resolved="$( { cd "$ROOT" || exit 0; docker compose ${prof_args[@]+"${prof_args[@]}"} config --format json 2>/dev/null; } \
        | python3 -c '
import json,sys
try:
    cfg = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for svc in (cfg.get("services") or {}).values():
    for p in (svc.get("ports") or []):
        pub = p.get("published")
        if pub:
            print(pub)
' 2>/dev/null || true)"
fi

# Fall back to the env file when compose or python is unavailable: a partial
# check beats none, and this path still catches every explicitly-set port.
if [[ -z "$resolved" ]]; then
    resolved="$(grep -E '^MDB_[A-Z0-9_]*(HOST_)?PORT=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"
fi

while IFS= read -r value; do
    [[ "$value" =~ ^[0-9]+$ ]] || continue
    case " $ours " in *" $value "*) continue ;; esac
    if port_in_use "$value"; then
        # Name the variable when one exists; the number alone is not actionable.
        # `|| true` because most published ports are compose defaults with no
        # line in the env file at all -- and a grep that finds nothing aborts
        # the script under set -e, which showed up as check-env exiting 1 with
        # no output whatsoever.
        # Named only when exactly ONE variable carries this value. Several can
        # -- 5432 is both the engine's port and HAProxy's write port -- and
        # naming an arbitrary one sends people to edit a setting that is not
        # the one being published.
        matches="$(grep -cE "^MDB_[A-Z0-9_]*(HOST_)?PORT=${value}\$" "$ENV_FILE" 2>/dev/null || true)"
        key=""
        if [[ "${matches:-0}" == "1" ]]; then
            key="$(grep -E "^MDB_[A-Z0-9_]*(HOST_)?PORT=${value}\$" "$ENV_FILE" 2>/dev/null \
                   | head -1 | cut -d= -f1 || true)"
        fi
        # Still nothing? Then the value is a compose DEFAULT and the env file
        # carries the setting commented out -- which is the common case for
        # anything a user has never changed, and the one where a bare number is
        # least useful. It happened with 8080: every other conflicting port
        # named its variable and that one printed alone, so the only way to find
        # the knob was to grep the compose file for the number.
        #
        # The line is named as commented, because telling someone to edit
        # MDB_ADMINER_HOST_PORT when their env file has no such active line
        # sends them looking for something that is not there.
        hint=""
        if [[ -z "$key" ]]; then
            commented="$(grep -cE "^#[[:space:]]*MDB_[A-Z0-9_]*(HOST_)?PORT=${value}\$" "$ENV_FILE" 2>/dev/null || true)"
            if [[ "${commented:-0}" == "1" ]]; then
                key="$(grep -E "^#[[:space:]]*MDB_[A-Z0-9_]*(HOST_)?PORT=${value}\$" "$ENV_FILE" 2>/dev/null \
                       | head -1 | sed 's/^#[[:space:]]*//' | cut -d= -f1 || true)"
                hint=", commented out -- uncomment it to change the port"
            fi
        fi
        taken="${taken}       $value${key:+ ($key$hint)}"$'\n'
    fi
done <<< "$resolved"

if [[ -n "$taken" ]]; then
    # An error when BOOTING -- binding is about to happen and Docker's own
    # message names neither the setting nor the process. Only a note when
    # RENDERING a prod file, which binds nothing: the machine that renders the
    # config is often not the machine that runs it, and `make init-prod` must
    # produce an env that passes check-env (SPEC section 18, criterion 2).
    if [[ "${MDB_CHECK_RENDERING:-0}" == "1" ]]; then
        note "port(s) currently in use on THIS machine (fine if you deploy elsewhere):
${taken%$'\n'}"
    else
        err "port(s) already in use on this machine:
${taken}       Change the setting, or stop whatever holds the port. On macOS:
       lsof -nP -iTCP:<port> -sTCP:LISTEN"
    fi
fi

# -----------------------------------------------------------------------------
# 5. Prod-profile guards (SPEC sections 18 and 21.1)
# -----------------------------------------------------------------------------
profiles="$(get MDB_PROFILES)"
if [[ ",${profiles}," == *",prod,"* ]]; then
    note "prod profile detected: applying prod guards"

    [[ "$(get MDB_TLS_ENFORCE)" == "true" ]] \
        || err "the prod profile requires MDB_TLS_ENFORCE=true"

    # Pooling is mandatory, not advisory: ~10 MB per direct PostgreSQL
    # connection means ~500 connections cost ~5 GB before a query runs.
    [[ -n "$(get MDB_PGBOUNCER_POOL_MODE)" ]] \
        || err "the prod profile requires a pooler (MDB_PGBOUNCER_POOL_MODE); see SPEC section 21.1"

    [[ -n "$(get MDB_UI_BASIC_AUTH_HASH)" ]] \
        || err "the prod profile requires MDB_UI_BASIC_AUTH_HASH on every UI route"

    # SPEC section 18, criterion 7c: the fresh VPS path ends with PITR active.
    # A nightly dump means losing up to a day; WAL archiving means losing up to
    # a transaction, and that is the difference this guard exists to enforce.
    [[ "$(get MDB_PG_PITR)" == "true" ]] \
        || err "the prod profile requires MDB_PG_PITR=true (SPEC section 18, 7c).
       Without WAL archiving, recovery granularity is the last dump."

    # posix is a local directory. It dies with the machine, which is the exact
    # scenario a backup exists for.
    if [[ "$(get MDB_PGBACKREST_REPO_TYPE)" != "s3" ]]; then
        err "the prod profile requires MDB_PGBACKREST_REPO_TYPE=s3 (SPEC section 18, 7b).
       A posix repository lives on the machine it is backing up."
    fi

    # The operator's own cloud credentials, so init cannot generate them.
    #
    # A hard error at BOOT, because failing here beats failing inside
    # archive_command where the only symptom is pg_wal growing while everything
    # reports healthy. But only a note while RENDERING a prod file, because
    # `make init-prod` must produce an env that passes check-env (SPEC section
    # 18, criterion 2) and it cannot invent someone's S3 keys. Same contract as
    # MDB_CADDY_ACME_EMAIL, which init-prod also surfaces as still-required.
    for f in pgbackrest_s3_key.txt pgbackrest_s3_secret.txt; do
        [[ -s "$ROOT/secrets/$f" ]] && continue
        if [[ "${MDB_CHECK_RENDERING:-0}" == "1" ]]; then
            note "still required before 'make up': secrets/$f (your object-store credentials)"
        else
            err "MDB_PGBACKREST_REPO_TYPE=s3 needs secrets/$f
       (your object-store credentials; they are never written to .env)"
        fi
    done

fi

# The etcd quorum is validated whenever the `ha` PROFILE is selected, which is
# what actually starts etcd. It used to hang off a separate MDB_HA_ENABLE
# flag, so `PROFILES=ha` with the flag left false ran HA with no validation at
# all -- two switches for one thing, free to disagree.

# -----------------------------------------------------------------------------
# 6. Secret files referenced must be resolvable once initialised
# -----------------------------------------------------------------------------
while IFS= read -r line; do
    key="${line%%=*}"; value="${line#*=}"
    [[ -z "$value" ]] && continue
    [[ "$value" == secrets/* ]] || continue
    if [[ ! -f "$ROOT/$value" ]] && [[ -f "$ROOT/.env" ]] && [[ "$ENV_FILE" == "$ROOT/.env" ]]; then
        err "$key points at $value, which does not exist (run: make init)"
    fi
done < <(grep -E '^MDB_[A-Z0-9_]*_FILE=' "$ENV_FILE" 2>/dev/null || true)

# -----------------------------------------------------------------------------
if (( errors )); then
    printf '\n%s✗ check-env failed with %d problem(s)%s\n' "$RED" "$errors" "$OFF" >&2
    exit 1
fi

(( QUIET )) || printf '%s✓ check-env passed%s (%s)\n' "$GRN" "$OFF" "${ENV_FILE#"$ROOT"/}"
