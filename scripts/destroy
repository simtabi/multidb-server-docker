#!/usr/bin/env bash
#
# Delete data volumes. This is the only command in the toolkit that destroys
# data, and it is built to be hard to do by accident (SPEC section 15).
#
# The confirmation requires TYPING THE VOLUME NAME, not "y". A yes/no prompt
# trains people to answer yes; typing the name of the thing you are about to
# lose does not, and it makes a mistyped or misremembered target fail closed.
#
# Usage: scripts/destroy [--volume NAME | --all]

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 1

PROJECT="${COMPOSE_PROJECT_NAME:-mmdb}"

log() { printf '[destroy] %s\n' "$*"; }
die() { printf '[destroy] ERROR: %s\n' "$*" >&2; exit 1; }

TARGET=""
ALL=0
INCLUDE_RECOVERY=0
while (( $# )); do
    case "$1" in
        --volume) TARGET="${2:-}"; shift 2 ;;
        --all)    ALL=1; shift ;;
        --include-recovery) INCLUDE_RECOVERY=1; shift ;;
        *) die "unknown argument: $1" ;;
    esac
done

list_volumes() {
    docker volume ls --format '{{.Name}}' | grep -E "^${PROJECT}_" | sort || true
}

# Recovery repositories -- the pgBackRest repo and the binary logs.
#
# These are EXCLUDED from --all, because a command that destroys the data and
# the means of recovering from it in one step is the worst possible default:
# the moment you most want a backup is immediately after destroying something.
# They live in separate volumes precisely so this distinction can exist, and
# --include-recovery is the way to say you meant it.
is_recovery_volume() {
    case "$1" in *_pitr) return 0 ;; *) return 1 ;; esac
}

volumes="$(list_volumes)"
[[ -n "$volumes" ]] || { log "no ${PROJECT}_ volumes exist; nothing to destroy"; exit 0; }

# Destroying a volume out from under a running engine corrupts it rather than
# removing it cleanly, so the stack has to be down first.
running="$(docker compose ps --format '{{.Service}}' 2>/dev/null | grep -c . || true)"
if [[ "${running:-0}" != "0" ]]; then
    die "the stack is still running. Run 'make down' first, then destroy."
fi

printf '\n'
printf 'Data volumes for project %s:\n\n' "$PROJECT"
while IFS= read -r v; do
    [[ -z "$v" ]] && continue
    size="$(docker volume inspect "$v" --format '{{.Mountpoint}}' >/dev/null 2>&1 && echo "" || echo "")"
    printf '  %s%s\n' "$v" "$size"
done <<< "$volumes"
printf '\n'

if (( ALL )); then
    targets=""; kept=""
    while IFS= read -r v; do
        [[ -z "$v" ]] && continue
        if is_recovery_volume "$v" && (( ! INCLUDE_RECOVERY )); then
            kept="${kept}${v}"$'\n'
        else
            targets="${targets}${v}"$'\n'
        fi
    done <<< "$volumes"

    [[ -n "$targets" ]] || { log "only recovery volumes remain; nothing to delete without --include-recovery"; exit 0; }

    count="$(printf '%s' "$targets" | grep -c .)"
    printf 'This will PERMANENTLY DELETE %s volume(s).\n' "$count"
    printf 'Every database in them is gone, and there is no undo.\n\n'
    if [[ -n "$kept" ]]; then
        printf 'KEEPING your recovery repositories, so a restore is still possible:\n'
        printf '%s' "$kept" | sed 's/^/  /'
        printf '\nAdd --include-recovery to delete those too.\n\n'
    fi
    printf 'Type DESTROY ALL to continue: '
    read -r answer
    [[ "$answer" == "DESTROY ALL" ]] || die "confirmation did not match; nothing was deleted"

    while IFS= read -r v; do
        [[ -z "$v" ]] && continue
        docker volume rm "$v" >/dev/null && log "deleted $v"
    done <<< "$targets"
    if [[ -n "$kept" ]]; then
        log "recovery repositories kept; restore with: make pitr-info"
    fi
    log "done"
    exit 0
fi

[[ -n "$TARGET" ]] || die "specify --volume <name> (from the list above), or --all"

printf '%s\n' "$volumes" | grep -qx "$TARGET" \
    || die "'$TARGET' is not a volume of project $PROJECT"

printf 'This will PERMANENTLY DELETE the volume %s.\n' "$TARGET"
printf 'Every database in it is gone, and there is no undo.\n\n'
printf 'Type the volume name to continue: '
read -r answer
[[ "$answer" == "$TARGET" ]] || die "confirmation did not match; nothing was deleted"

docker volume rm "$TARGET" >/dev/null
log "deleted $TARGET"
